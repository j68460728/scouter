#!/usr/bin/env python3
"""GSR experiment: measure empirical relationship between Match GSR and results."""

import os
import sys
import math
from collections import defaultdict

sys.path.insert(0, os.path.join(os.path.dirname(os.path.dirname(__file__)), 'src'))
from config import GSR_MATCHES
from backtesting.historical_data import load_csv_data, get_recent_for_team
from utils import gsr_from_matches

LEAGUES = ["PL", "BL1", "PD", "SA", "FL1"]
SEASONS = ["2023", "2024"]

def run_gsr_experiment():
    all_samples = []

    for league in LEAGUES:
        for season in SEASONS:
            matches = load_csv_data(league, season)
            if not matches:
                continue

            print(f"[GSR] Processing {league} {season}/{int(season)+1} ({len(matches)} matches)...")

            for i, match in enumerate(matches):
                before = matches[:i]

                home_id = match['homeTeam']['id']
                away_id = match['awayTeam']['id']

                home_recent = get_recent_for_team(before, home_id, window=GSR_MATCHES)
                away_recent = get_recent_for_team(before, away_id, window=GSR_MATCHES)

                if len(home_recent) < 5 or len(away_recent) < 5:
                    continue

                home_gsr = gsr_from_matches(home_recent, home_id) / GSR_MATCHES
                away_gsr = gsr_from_matches(away_recent, away_id) / GSR_MATCHES
                match_gsr = round(home_gsr - away_gsr, 2)

                ft = match.get('score', {}).get('fullTime', {})
                hg = ft.get('home', 0) or 0
                ag = ft.get('away', 0) or 0
                if hg > ag:
                    result = "H"
                elif ag > hg:
                    result = "A"
                else:
                    result = "D"

                all_samples.append({
                    "match_id": match['id'],
                    "league": league,
                    "season": season,
                    "home_team": match['homeTeam']['name'],
                    "away_team": match['awayTeam']['name'],
                    "home_gsr": round(home_gsr, 2),
                    "away_gsr": round(away_gsr, 2),
                    "match_gsr": match_gsr,
                    "result": result,
                    "home_gf": hg,
                    "away_gf": ag,
                })

    return all_samples


def analyze_gsr(samples):
    print(f"\nTotal matches with both teams ≥5 recent: {len(samples)}\n")

    gsr_values = [s['match_gsr'] for s in samples]

    import statistics
    print(f"Match GSR distribution:")
    print(f"  Mean:   {statistics.mean(gsr_values):.3f}")
    print(f"  Median: {statistics.median(gsr_values):.3f}")
    print(f"  Stdev:  {statistics.stdev(gsr_values):.3f}")
    print(f"  Min:    {min(gsr_values):.3f}")
    print(f"  Max:    {max(gsr_values):.3f}")
    p5 = sorted(gsr_values)[int(len(gsr_values) * 0.05)]
    p95 = sorted(gsr_values)[int(len(gsr_values) * 0.95)]
    print(f"  P5:     {p5:.3f}")
    print(f"  P95:    {p95:.3f}")

    # Bucket by Match GSR
    buckets = defaultdict(list)
    for s in samples:
        gsr = s['match_gsr']
        if gsr < -3.0:
            key = "< -3.0"
        elif gsr >= 3.0:
            key = "≥ 3.0"
        else:
            b = int(math.floor(gsr / 0.5) * 0.5)
            if b >= 0:
                key = f"{b:.1f}–{b+0.5:.1f}"
            else:
                key = f"{b-0.5:.1f}–{b:.1f}"
        buckets[key].append(s)

    print(f"\nMatch GSR buckets (0.5 width):")
    print(f"  {'Bucket':>14} {'Total':>6}  {'H':>6}  {'D':>6}  {'A':>6}  {'H%':>7}  {'D%':>7}  {'A%':>7}")
    for key in sorted(buckets.keys(), key=_sort_key):
        group = buckets[key]
        n = len(group)
        h = sum(1 for s in group if s['result'] == 'H')
        d = sum(1 for s in group if s['result'] == 'D')
        a = sum(1 for s in group if s['result'] == 'A')
        print(f"  {key:>14} {n:>6} {h:>6} {d:>6} {a:>6} {h/n*100:>6.1f}% {d/n*100:>6.1f}% {a/n*100:>6.1f}%")

    # Coarser buckets for clearer trend
    coarse = [(-5, -2.5), (-2.5, -1.5), (-1.5, -0.5), (-0.5, 0.5), (0.5, 1.5), (1.5, 2.5), (2.5, 5)]
    print(f"\nCoarse buckets:")
    print(f"  {'Range':>14} {'Total':>6}  {'H':>6}  {'D':>6}  {'A':>6}  {'H%':>7}  {'D%':>7}  {'A%':>7}")
    for lo, hi in coarse:
        group = [s for s in samples if lo <= s['match_gsr'] < hi]
        if not group:
            continue
        n = len(group)
        h = sum(1 for s in group if s['result'] == 'H')
        d = sum(1 for s in group if s['result'] == 'D')
        a = sum(1 for s in group if s['result'] == 'A')
        label = f"{lo}–{hi}"
        print(f"  {label:>14} {n:>6} {h:>6} {d:>6} {a:>6} {h/n*100:>6.1f}% {d/n*100:>6.1f}% {a/n*100:>6.1f}%")

    # Monotonicity check
    print(f"\nMonotonicity check:")
    bin_centers = []
    h_rates = []
    for lo, hi in coarse:
        group = [s for s in samples if lo <= s['match_gsr'] < hi]
        if not group:
            continue
        n = len(group)
        h = sum(1 for s in group if s['result'] == 'H')
        bin_centers.append((lo + hi) / 2)
        h_rates.append(h / n)

    # Check if H% is monotonically increasing with match_gsr
    monotonic = all(h_rates[i] <= h_rates[i+1] for i in range(len(h_rates)-1))
    print(f"  H% monotonic increase: {'YES ✓' if monotonic else 'NO ✗'}")
    for i, (c, r) in enumerate(zip(bin_centers, h_rates)):
        arrow = " →" if i < len(bin_centers) - 1 else ""
        print(f"    GSR ~ {c:>4.1f}: H% = {r*100:.1f}%{arrow}")

    # Compare with PDF expectations
    print(f"\nComparison with baseline home win rate:")
    h_total = sum(1 for s in samples if s['result'] == 'H')
    d_total = sum(1 for s in samples if s['result'] == 'D')
    a_total = sum(1 for s in samples if s['result'] == 'A')
    n_total = len(samples)
    print(f"  Overall: H={h_total/n_total*100:.1f}%  D={d_total/n_total*100:.1f}%  A={a_total/n_total*100:.1f}%")

    # Signal strength: correlation between match GSR and result
    result_num = {'H': 2, 'D': 1, 'A': 0}
    y = [result_num[s['result']] for s in samples]
    x = [s['match_gsr'] for s in samples]
    n = len(x)
    mx = statistics.mean(x)
    my = statistics.mean(y)
    num = sum((x[i] - mx) * (y[i] - my) for i in range(n))
    den = math.sqrt(sum((x[i] - mx)**2 for i in range(n))) * math.sqrt(sum((y[i] - my)**2 for i in range(n)))
    r = num / den if den != 0 else 0
    print(f"\n  Pearson r(Match GSR, result): {r:.4f}")
    print(f"  r²: {r*r:.4f}")

    # Signal by league
    print(f"\nPer-league signal:")
    for league in LEAGUES:
        lg = [s for s in samples if s['league'] == league]
        if not lg:
            continue
        yl = [result_num[s['result']] for s in lg]
        xl = [s['match_gsr'] for s in lg]
        ml = len(lg)
        mxl = statistics.mean(xl)
        myl = statistics.mean(yl)
        numl = sum((xl[i] - mxl) * (yl[i] - myl) for i in range(ml))
        denl = math.sqrt(sum((xl[i] - mxl)**2 for i in range(ml))) * math.sqrt(sum((yl[i] - myl)**2 for i in range(ml)))
        rl = numl / denl if denl != 0 else 0
        h_lg = sum(1 for s in lg if s['result'] == 'H')
        print(f"  {league}: n={len(lg)}  H%={h_lg/len(lg)*100:.1f}%  r={rl:.4f}")


def _sort_key(key):
    if key.startswith("<"):
        return -999
    if key.startswith("≥"):
        return 999
    try:
        return float(key.split("–")[0])
    except:
        return 0


if __name__ == "__main__":
    samples = run_gsr_experiment()
    analyze_gsr(samples)
