#!/usr/bin/env python3
"""Audit tool for backtest results: PL 2024/25 anomaly + GSR diagnostic."""

import os
import sys
import json
from collections import Counter

sys.path.insert(0, os.path.join(os.path.dirname(os.path.dirname(__file__)), 'src'))
from backtesting.historical_data import load_csv_data, compute_standings

# ── Load latest results ─────────────────────────────────────────────
def _load_results():
    pat = "backtest_results_*.json"
    import glob
    files = sorted(glob.glob(pat))
    if not files:
        print("No backtest results found. Run ./bin/backtest first.")
        sys.exit(1)
    latest = files[-1]
    with open(latest) as f:
        return json.load(f), latest

rows, fpath = _load_results()
print(f"[Audit] Loaded {len(rows)} records from {fpath}\n")

# ═══════════════════════════════════════════════════════════════════
# PART 1: PL 2024/25 ANOMALY
# ═══════════════════════════════════════════════════════════════════
def audit_pl_2425(rows):
    print("=" * 60)
    print("  PARTE 1 — AUDITORÍA PL 2024/25")
    print("=" * 60)

    pl_2324 = [r for r in rows if r['league'] == 'PL' and r['season'] == '2023']
    pl_2425 = [r for r in rows if r['league'] == 'PL' and r['season'] == '2024']

    def stats(group, label):
        sel = [r for r in group if r['selected']]
        correct = sum(1 for r in sel if r['correct'] == 1)
        print(f"\n  {label}:")
        print(f"    Total:     {len(group)}")
        print(f"    Selected:  {len(sel)} ({len(sel)/len(group)*100:.1f}%)")
        print(f"    Correct:   {correct} ({correct/len(sel)*100:.1f}%)")
        # By diff range
        for lo, hi in [(15, 19), (20, 24), (25, 29), (30, 999)]:
            bucket = [r for r in sel if lo <= r['difference'] <= hi]
            if bucket:
                corr = sum(1 for r in bucket if r['correct'] == 1)
                print(f"    Diff {lo}-{hi if hi<999 else '+'}: {len(bucket):>3} sel  {corr:>3} corr  {corr/len(bucket)*100:.1f}%")
        # By month
        from collections import defaultdict
        by_month = defaultdict(lambda: {"total": 0, "selected": 0, "correct": 0})
        for r in group:
            month = r['date'][:7]
            by_month[month]["total"] += 1
            if r['selected']:
                by_month[month]["selected"] += 1
                if r['correct'] == 1:
                    by_month[month]["correct"] += 1
        print(f"\n    --- By month ---")
        for month in sorted(by_month.keys()):
            v = by_month[month]
            acc = v['correct'] / v['selected'] * 100 if v['selected'] else 0
            print(f"    {month}: {v['selected']}/{v['total']} sel  acc: {acc:.1f}%")

    stats(pl_2324, "  PL 2023/24")
    stats(pl_2425, "  PL 2024/25")

    # Compare standings distribution
    print(f"\n  --- Standings spread comparison ---")
    for season, group in [("2023/24", pl_2324), ("2024/25", pl_2425)]:
        max_s = max(r['home_strength'] for r in group)
        min_s = min(r['home_strength'] for r in group)
        avg_s = sum(r['home_strength'] for r in group) / len(group)
        diffs = [r['difference'] for r in group]
        avg_diff = sum(diffs) / len(diffs)
        sel_diffs = [r['difference'] for r in group if r['selected']]
        avg_sel_diff = sum(sel_diffs) / len(sel_diffs) if sel_diffs else 0
        print(f"    {season}: str=[{min_s:.0f}–{max_s:.0f}] avg={avg_s:.1f}  avg_diff={avg_diff:.1f}  avg_sel_diff={avg_sel_diff:.1f}")

    # Check wins distribution (home/draw/away)
    print(f"\n  --- Actual result distribution ---")
    for season, group in [("2023/24", pl_2324), ("2024/25", pl_2425)]:
        h = sum(1 for r in group if r['actual_code'] == 'home')
        d = sum(1 for r in group if r['actual_code'] == 'draw')
        a = sum(1 for r in group if r['actual_code'] == 'away')
        print(f"    {season}: H={h} ({h/len(group)*100:.1f}%)  D={d} ({d/len(group)*100:.1f}%)  A={a} ({a/len(group)*100:.1f}%)")

    # Favorite direction breakdown for selected
    print(f"\n  --- Favorite direction (selected only) ---")
    for season, group in [("2023/24", pl_2324), ("2024/25", pl_2425)]:
        sel = [r for r in group if r['selected']]
        home_fav = [r for r in sel if r['favorite'] == r['home_team']]
        away_fav = [r for r in sel if r['favorite'] != r['home_team']]
        h_acc = sum(1 for r in home_fav if r['correct'] == 1) / len(home_fav) * 100 if home_fav else 0
        a_acc = sum(1 for r in away_fav if r['correct'] == 1) / len(away_fav) * 100 if away_fav else 0
        print(f"    {season}: home_fav={len(home_fav)} ({h_acc:.1f}%)  away_fav={len(away_fav)} ({a_acc:.1f}%)")

audit_pl_2425(rows)

# ═══════════════════════════════════════════════════════════════════
# PART 2: GSR / RECENT FORM DIAGNOSTIC
# ═══════════════════════════════════════════════════════════════════
def audit_gsr(rows):
    print("\n" + "=" * 60)
    print("  PARTE 2 — DIAGNÓSTICO DE RECENT FORM / GSR")
    print("=" * 60)

    # Collect all unique (league, season) pairs
    from backtesting.engine import _load_season
    from config import GSR_MATCHES

    pairs = set((r['league'], r['season']) for r in rows)

    all_gsr_values = []
    all_ppg6_values = []
    all_ga_values = []
    all_struct_ppg = []
    all_struct_gd = []
    teams_with_recent = 0
    teams_without_recent = 0

    for league, season in sorted(pairs):
        matches = _load_season(league, season)
        n = len(matches)
        for i in range(n):
            before = matches[:i]
            standings = compute_standings(before)
            for tid in set([matches[i]['homeTeam']['id'], matches[i]['awayTeam']['id']]):
                team_results = [m for m in before
                                if m['homeTeam']['id'] == tid or m['awayTeam']['id'] == tid]
                has_recent = len(team_results) >= 5
                if has_recent:
                    teams_with_recent += 1
                    recent = team_results[-GSR_MATCHES:]

                    from utils import gsr_from_matches, ppg_from_matches, goals_avg_from_matches
                    gsr_raw = gsr_from_matches(recent, tid)
                    gsr_per_match = gsr_raw / GSR_MATCHES
                    all_gsr_values.append(gsr_per_match)
                    all_ppg6_values.append(ppg_from_matches(recent, tid))
                    all_ga_values.append(goals_avg_from_matches(recent, tid))

                    # Structural PPG and GD
                    st = standings.get(tid, {})
                    all_struct_ppg.append(st.get('ppg', 0))
                    all_struct_gd.append(st.get('goal_difference', 0))
                else:
                    teams_without_recent += 1

    print(f"\n  Teams with recent data:    {teams_with_recent}")
    print(f"  Teams without recent data: {teams_without_recent}")
    print(f"  Total samples:             {teams_with_recent + teams_without_recent}")

    import statistics

    def _stats(values, label):
        if not values:
            print(f"\n  {label}: NO DATA")
            return
        neg = sum(1 for v in values if v < 0)
        zero = sum(1 for v in values if v == 0)
        pos = sum(1 for v in values if v > 0)
        print(f"\n  {label}:")
        print(f"    Mean:     {statistics.mean(values):.3f}")
        print(f"    Median:   {statistics.median(values):.3f}")
        print(f"    Stdev:    {statistics.stdev(values):.3f}")
        print(f"    Min:      {min(values):.3f}")
        print(f"    Max:      {max(values):.3f}")
        print(f"    <0: {neg}  =0: {zero}  >0: {pos}")

    _stats(all_gsr_values, "GSR per match (raw, BEFORE normalization)")
    _stats(all_ppg6_values, "PPG last 6 matches")
    _stats(all_ga_values, "Goal average last 6 matches")
    _stats(all_struct_ppg, "Structural PPG (full season)")
    _stats(all_struct_gd, "Structural GD (full season)")

    # Correlation: GSR vs structural PPG
    if all_gsr_values and all_struct_ppg:
        n = min(len(all_gsr_values), len(all_struct_ppg))
        gsr = all_gsr_values[:n]
        ppg = all_struct_ppg[:n]
        # Pearson correlation
        import math
        mx = statistics.mean(gsr)
        my = statistics.mean(ppg)
        num = sum((x - mx) * (y - my) for x, y in zip(gsr, ppg))
        den = math.sqrt(sum((x - mx)**2 for x in gsr)) * math.sqrt(sum((y - my)**2 for y in ppg))
        r = num / den if den != 0 else 0
        print(f"\n  --- Correlation with structural PPG ---")
        print(f"    Pearson r(GSR, struct_PPG): {r:.4f}")
        print(f"    r²: {r*r:.4f}")

    # GSR clamped analysis
    norm_max_gsr = 18
    gsr_normalized = [max(0, v) / norm_max_gsr * 15 for v in all_gsr_values]
    clamped_to_zero = sum(1 for v in all_gsr_values if v < 0)
    print(f"\n  --- GSR clamping analysis ---")
    print(f"    GSR < 0 (clamped to 0): {clamped_to_zero}/{len(all_gsr_values)} ({clamped_to_zero/len(all_gsr_values)*100:.1f}%)")
    print(f"    GSR final score mean:   {statistics.mean(gsr_normalized):.3f} / 15")
    print(f"    GSR final score max:    {max(gsr_normalized):.3f} / 15")

    # PPG component
    ppg_scores = [max(0, v) / 3.0 * 10 for v in all_ppg6_values]
    print(f"\n  --- Recent PPG analysis ---")
    print(f"    Mean: {statistics.mean(ppg_scores):.3f} / 10")
    print(f"    Max:  {max(ppg_scores):.3f} / 10")

    # Goal average component
    ga_scores = [v / 5.0 * 5 for v in all_ga_values]
    print(f"\n  --- Recent Goal Average analysis ---")
    print(f"    Mean: {statistics.mean(ga_scores):.3f} / 5")
    print(f"    Max:  {max(ga_scores):.3f} / 5")

    # Total recent form actual contribution
    total_recent = [g + p + ga for g, p, ga in zip(gsr_normalized, ppg_scores, ga_scores)]
    print(f"\n  --- Total Recent Form contribution (0-30 scale) ---")
    print(f"    Mean: {statistics.mean(total_recent):.3f} / 30")
    print(f"    Max:  {max(total_recent):.3f} / 30")
    print(f"    Min:  {min(total_recent):.3f} / 30")

    # How many matches have recent_form > 5 (significant contribution)?
    significant = sum(1 for v in total_recent if v >= 5)
    print(f"    >= 5:  {significant}/{len(total_recent)} ({significant/len(total_recent)*100:.1f}%)")
    very_low = sum(1 for v in total_recent if v < 2)
    print(f"    < 2:   {very_low}/{len(total_recent)} ({very_low/len(total_recent)*100:.1f}%)")

audit_gsr(rows)
