#!/usr/bin/env python3
"""OOS evaluation: Scouter Engine v2 on 2024/25 only — frozen config."""

import os
import sys
from collections import Counter

sys.path.insert(0, os.path.join(os.path.dirname(os.path.dirname(__file__)), 'src'))
from strength_profile import _load_matrix, build_match
from backtesting.historical_data import load_csv_data, compute_standings

LEAGUES = ["PL", "BL1", "PD", "SA", "FL1"]

def run_oos():
    matrix = _load_matrix()
    min_diff = matrix['confidence']['min_difference']
    print(f"[OOS] Scouter Engine v2 — 2024/25 only")
    print(f"[OOS] Config: Structural+Context, threshold={min_diff}")
    print(f"[OOS] Leagues: {', '.join(LEAGUES)}\n")

    rows = []
    for league in LEAGUES:
        matches = load_csv_data(league, "2024")
        if not matches:
            continue
        for i, match in enumerate(matches):
            before = matches[:i]
            standings = compute_standings(before)
            me = {
                "home_team": match['homeTeam']['name'],
                "home_id": match['homeTeam']['id'],
                "away_team": match['awayTeam']['name'],
                "away_id": match['awayTeam']['id'],
                "competition_code": league,
                "date": match['utcDate'],
                "stage": match.get('stage', 'REGULAR_SEASON'),
            }
            home, away = build_match(me, standings, {}, matrix)
            diff = round(abs(home['total'] - away['total']), 1)
            fav = match['homeTeam']['name'] if home['total'] >= away['total'] else match['awayTeam']['name']
            ft = match.get('score', {}).get('fullTime', {})
            hg = ft.get('home', 0) or 0
            ag = ft.get('away', 0) or 0
            if hg > ag: ac = "home"; aw = match['homeTeam']['name']
            elif ag > hg: ac = "away"; aw = match['awayTeam']['name']
            else: ac = "draw"; aw = "draw"
            sel = diff >= min_diff
            rows.append({
                "match_id": match['id'], "league": league,
                "date": match['utcDate'], "matchday": match.get('matchday', 0),
                "home_team": match['homeTeam']['name'], "away_team": match['awayTeam']['name'],
                "home_strength": home['total'], "away_strength": away['total'],
                "home_struct": home['structural'], "home_ctx": home['context'],
                "away_struct": away['structural'], "away_ctx": away['context'],
                "difference": diff, "favorite": fav,
                "selected": sel, "actual_winner": aw, "actual_code": ac,
                "correct": (1 if sel and fav == aw else (0 if sel else None)),
            })
    return rows


def report(rows):
    total = len(rows)
    sel = [r for r in rows if r['selected']]
    n_sel = len(sel)
    corr = sum(1 for r in sel if r['correct'] == 1)
    cov = n_sel / total
    acc = corr / n_sel if n_sel else 0
    baseline = sum(1 for r in rows if r['actual_code'] == "home") / total
    draws = sum(1 for r in rows if r['actual_code'] == "draw") / total

    # By diff range
    ranges = [(20, 24), (25, 29), (30, 999)]
    range_data = {}
    for lo, hi in ranges:
        bucket = [r for r in sel if lo <= r['difference'] <= hi]
        n_b = len(bucket)
        c_b = sum(1 for r in bucket if r['correct'] == 1)
        range_data[f"{lo}-{hi if hi<999 else '+'}"] = (n_b, c_b, c_b/n_b if n_b else 0)

    # By league
    leagues = {}
    for r in rows:
        lg = r['league']
        leagues.setdefault(lg, {"t": 0, "s": 0, "c": 0})
        leagues[lg]["t"] += 1
        if r['selected']:
            leagues[lg]["s"] += 1
            if r['correct'] == 1:
                leagues[lg]["c"] += 1

    # Home/away favorite
    home_fav = [r for r in sel if r['favorite'] == r['home_team']]
    away_fav = [r for r in sel if r['favorite'] != r['home_team']]
    hf_acc = sum(1 for r in home_fav if r['correct'] == 1) / len(home_fav) if home_fav else 0
    af_acc = sum(1 for r in away_fav if r['correct'] == 1) / len(away_fav) if away_fav else 0

    # Confusion matrix
    classes = ["home", "draw", "away"]
    cm = {p: {a: 0 for a in classes} for p in classes}
    for r in rows:
        pred = "home" if r['home_strength'] > r['away_strength'] else "away" if r['away_strength'] > r['home_strength'] else "draw"
        cm[pred][r['actual_code']] += 1

    # Strength distribution
    diffs = [r['difference'] for r in rows]
    avg_diff = sum(diffs) / len(diffs)
    sel_diffs = [r['difference'] for r in sel]
    avg_sel_diff = sum(sel_diffs) / len(sel_diffs) if sel_diffs else 0

    # — Print report —
    print("=" * 70)
    print("  OOS REPORT — SCOUTER ENGINE v2 — 2024/25")
    print("=" * 70)
    print(f"\n  Total matches:      {total}")
    print(f"  Selected (≥20):     {n_sel} ({cov*100:.1f}%)")
    print(f"  Accuracy:           {acc*100:.1f}%")
    print(f"  Baseline (home):    {baseline*100:.1f}%")
    print(f"  Draw rate:          {draws*100:.1f}%")
    print(f"  Avg diff:           {avg_diff:.1f}  (selected: {avg_sel_diff:.1f})")
    print(f"  Home fav acc:       {hf_acc*100:.1f}%  ({len(home_fav)} matches)")
    print(f"  Away fav acc:       {af_acc*100:.1f}%  ({len(away_fav)} matches)")

    print(f"\n  --- By diff range ---")
    for label, (n, c, a) in range_data.items():
        print(f"    {label:>6}: {n:>4} sel  {c:>4} corr  {a*100:5.1f}%")

    print(f"\n  --- By league ---")
    for lg, v in sorted(leagues.items()):
        a_lg = v["c"] / v["s"] if v["s"] else 0
        print(f"    {lg}: {v['s']:>4}/{v['t']:>4} ({v['s']/v['t']*100:.1f}%)  acc: {a_lg*100:.1f}%")

    print(f"\n  --- Confusion matrix (all matches) ---")
    print(f"    {'':>8} {'home':>6} {'draw':>6} {'away':>6}")
    for pred in ["home", "draw", "away"]:
        print(f"    {pred:>8} {cm[pred]['home']:>6} {cm[pred]['draw']:>6} {cm[pred]['away']:>6}")

    # Comparison with 2023/24
    print(f"\n  --- Comparison with 2023/24 calibration ---")
    print(f"    {'':>20} {'2023/24':>10} {'2024/25':>10}")
    print(f"    {'Coverage':>20} {'15.9%':>10} {f'{cov*100:.1f}%':>10}")
    print(f"    {'Accuracy':>20} {'72.0%':>10} {f'{acc*100:.1f}%':>10}")
    print(f"    {'Baseline home':>20} {'42.5%':>10} {f'{baseline*100:.1f}%':>10}")
    print(f"    {'Draw rate':>20} {'25.7%':>10} {f'{draws*100:.1f}%':>10}")
    print()

    return {
        "n_matches": total, "n_selected": n_sel, "coverage": round(cov, 4),
        "accuracy": round(acc, 4), "baseline": round(baseline, 4),
        "home_fav_acc": round(hf_acc, 4), "away_fav_acc": round(af_acc, 4),
    }


if __name__ == "__main__":
    rows = run_oos()
    if not rows:
        print("[OOS] No data.")
        sys.exit(1)
    report(rows)
