#!/usr/bin/env python3
"""Threshold calibration for Scouter Engine v2 — Structural + Context only."""

import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.dirname(__file__)), 'src'))
import sys
import os

sys.path.insert(0, os.path.join(os.path.dirname(os.path.dirname(__file__)), 'src'))

from strength_profile import _load_matrix, build_match
from backtesting.metrics import compute_metrics
from backtesting.historical_data import load_csv_data, compute_standings

LEAGUES = ["PL", "BL1", "PD", "SA", "FL1"]
THRESHOLDS = [12, 15, 18, 20, 25]


def run_calibration_only(min_diff):
    """Run backtest on 2023/24 only (calibration set)."""
    matrix = _load_matrix()
    rows = []

    for league_code in LEAGUES:
        matches = load_csv_data(league_code, "2023")
        if not matches:
            continue
        for i, match in enumerate(matches):
            before = matches[:i]
            standings = compute_standings(before)
            team_results = {}
            match_eval = {
                "home_team": match['homeTeam']['name'],
                "home_id": match['homeTeam']['id'],
                "away_team": match['awayTeam']['name'],
                "away_id": match['awayTeam']['id'],
                "competition_code": league_code,
                "date": match['utcDate'],
                "stage": match.get('stage', 'REGULAR_SEASON'),
            }
            home, away = build_match(match_eval, standings, team_results, matrix)
            diff = round(abs(home['total'] - away['total']), 1)
            favorite = match['homeTeam']['name'] if home['total'] >= away['total'] else match['awayTeam']['name']
            ft = match.get('score', {}).get('fullTime', {})
            hg = ft.get('home', 0) or 0
            ag = ft.get('away', 0) or 0
            if hg > ag: ac = "home"; aw = match['homeTeam']['name']
            elif ag > hg: ac = "away"; aw = match['awayTeam']['name']
            else: ac = "draw"; aw = "draw"
            selected = diff >= min_diff
            rows.append({
                "match_id": match['id'], "league": league_code, "season": "2023",
                "date": match['utcDate'], "home_team": match['homeTeam']['name'],
                "away_team": match['awayTeam']['name'], "home_strength": home['total'],
                "away_strength": away['total'], "difference": diff, "favorite": favorite,
                "selected": selected, "actual_winner": aw, "actual_code": ac,
                "correct": (1 if selected and favorite == aw else (0 if selected else None)),
            })
    return rows


def key_or_default(by_diff, label):
    """Look up a diff range key, trying both 'lo-hi' and '30+' variants."""
    for candidate in [label, label.replace('-+', '+')]:
        if candidate in by_diff:
            v = by_diff[candidate]
            return f"{v['count']} ({v['accuracy']*100:.0f}%)"
    return "-"


def main():
    print("[Calibrate] Structural + Context only — calibration on 2023/24")
    print(f"[Calibrate] Thresholds: {', '.join(str(t) for t in THRESHOLDS)}\n")

    results = {}
    for th in THRESHOLDS:
        print(f"  Running threshold = {th}...")
        rows = run_calibration_only(min_diff=th)
        results[th] = compute_metrics(rows)
        print(f"    selected={results[th]['n_selected']}  acc={results[th]['accuracy']*100:.1f}%")

    print("\n" + "=" * 100)
    print("  THRESHOLD CALIBRATION — 2023/24 ONLY (Structural + Context)")
    print("=" * 100)
    print(f"  {'Thr':>4} {'Sel':>6} {'Cob.':>6}  {'Acc.':>6}  {'15-19':>12}  {'20-24':>12}  {'25-29':>12}  {'30+':>10}")
    print(f"  {'':->4} {'':->6} {'':->6}  {'':->6}  {'':->12}  {'':->12}  {'':->12}  {'':->10}")
    for th in THRESHOLDS:
        m = results[th]
        bd = m["by_diff"]
        print(f"  {th:>4} {m['n_selected']:>6} {m['coverage']*100:>5.1f}%  {m['accuracy']*100:>5.1f}%"
              f"  {key_or_default(bd, '15-19'):>12}  {key_or_default(bd, '20-24'):>12}"
              f"  {key_or_default(bd, '25-29'):>12}  {key_or_default(bd, '30-+'):>10}")

    print("\n[Calibrate] Done.")


if __name__ == "__main__":
    main()


if __name__ == "__main__":
    main()
